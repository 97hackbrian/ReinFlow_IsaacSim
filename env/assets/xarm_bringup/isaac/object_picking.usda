        def OmniGraphNode "script_node" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ros2_position_respawn/ros2_subscribe_twist.outputs:execOut>
            custom string inputs:script = '''import numpy as np
from pxr import Gf
import omni.graph.core as og

def setup(db: og.Database):
    pass

def cleanup(db: og.Database):
    pass

def compute(db: og.Database):
    stage = omni.usd.get_context().get_stage()
    screwdriver = stage.GetPrimAtPath("/World/screwdriver")

    # Read 2D position from the Twist message (sent by episode_generator_picking)
    graph = db.node.get_graph()
    twist_node = graph.get_node("/World/ros2_position_respawn/ros2_subscribe_twist")

    lin = og.Controller.get(
        og.Controller.attribute("outputs:linearVelocity", twist_node))

    x_coor = float(lin[0]) if lin is not None and abs(lin[0]) > 1e-6 else 0.35
    y_coor = float(lin[1]) if lin is not None and abs(lin[1]) > 1e-6 else 0.10
    z_coor = float(lin[2]) if lin is not None and abs(lin[2]) > 1e-6 else 0.012

    new_position = Gf.Vec3d(x_coor, y_coor, z_coor)
    screwdriver.GetAttribute("xformOp:translate").Set(new_position)

    print(f"[Respawn] pos=({x_coor:.3f}, {y_coor:.3f}, {z_coor:.3f})")

    '''
            custom token inputs:scriptPath
            custom bool inputs:usePath
            token node:type = "omni.graph.scriptnode.ScriptNode"
            int node:typeVersion = 2
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom bool state:omni_initialized
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (804.27783, -75.276)
        }

